# 复制为 .env（放在 python-engine/ 下），或直接用系统环境变量。
# 插件 bridge.js 读取优先级：环境变量 > <engineRoot>/.env > ~/.zshrc（仅非 Windows 兜底）。
DEEPSEEK_API_KEY=sk-xxx
LOTA_API_KEY=xxx

# 数据接口地址（可选）：缺省走公开域名；自建/私有端点在这里覆盖，别写进代码
# LOTA_API_BASE=http://your-api-host:<port>/predictions/api/v2

# 邮件（可选；QQ 或 163 二选一）
# QQ_EMAIL_ADDR=your@qq.com
# QQ_EMAIL_AUTH_CODE=授权码
# EMAIL_163_ADDR=your@163.com
# EMAIL_163_AUTH_CODE=授权码
